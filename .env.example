# Banco SQLite (desenvolvimento)
DATABASE_URL="file:./prisma/dev.db"

# Sessão JWT
AUTH_SECRET="dev-secret-change-me-please-32bytes-minimum-000"

# Mercado Pago Point (maquininha)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TERMINAL_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# API genérica de máquinas (fallback)
TERMINAL_API_KEY=adega-terminal-dev-key-change-me
