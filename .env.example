# Banco SQLite
DATABASE_URL="file:./prisma/dev.db"

# Sessão JWT — OBRIGATÓRIO. O sistema recusa iniciar sem essa variável.
# Gere um valor único e forte por ambiente, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilize o valor deste arquivo de exemplo nem o commit no Git.
AUTH_SECRET=""

# Opcional: credenciais via .env (alternativa ao painel Pagamentos da loja)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_TERMINAL_ID=
# MERCADOPAGO_WEBHOOK_SECRET=
# TERMINAL_API_KEY=

# Cobrança SaaS da plataforma (Mercado Pago Assinaturas)
# Alternativa ao painel /plataforma/cobranca
# PLATFORM_MP_ACCESS_TOKEN=
# PLATFORM_MP_WEBHOOK_SECRET=

# WhatsApp suporte (botão flutuante)
# NEXT_PUBLIC_SUPPORT_WHATSAPP=5564999999999
