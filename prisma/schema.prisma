generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Papel do usuário dentro da loja (tenant).
enum Role {
  ADMIN
  CAIXA
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// Cliente / loja isolada no SaaS.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  categories      Category[]
  products        Product[]
  stockMovements  StockMovement[]
  sales           Sale[]
  auditLogs       AuditLog[]
  paymentSettings PaymentSettings?
  subscription    Subscription?
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @default(TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  priceMonthly       Float              @default(0)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model User {
  id              String   @id @default(cuid())
  /// null = administrador da plataforma (super-admin)
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username        String
  name            String
  password        String
  role            Role     @default(CAIXA)
  isPlatformAdmin Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sales     Sale[]
  auditLogs AuditLog[]

  @@unique([tenantId, username])
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([tenantId, name])
}

model Product {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barcode    String
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  cost       Float     @default(0)
  price      Float     @default(0)
  stock      Int       @default(0)
  minStock   Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  movements StockMovement[]
  saleItems SaleItem[]

  @@unique([tenantId, barcode])
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())
}

enum SaleStatus {
  AGUARDANDO_PAGAMENTO
  CONCLUIDA
  CANCELADA
}

enum PaymentSource {
  IMEDIATO
  TERMINAL
  MERCADOPAGO
  SUMUP
  TON
  MANUAL
}

enum PaymentProviderType {
  GENERIC
  MERCADOPAGO
  SUMUP
  TON
}

model PaymentSettings {
  id                String              @id @default(cuid())
  tenantId          String              @unique
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activeProvider    PaymentProviderType @default(GENERIC)
  terminalApiKey    String?
  mpAccessToken     String?
  mpTerminalId      String?
  mpWebhookSecret   String?
  sumupApiKey       String?
  sumupMerchantCode String?
  tonApiKey         String?
  tonMerchantId     String?
  /// Taxa estimada (%) sobre vendas no débito — usada no lucro líquido
  debitFeePercent   Float               @default(1.5)
  /// Taxa estimada (%) sobre vendas no crédito — usada no lucro líquido
  creditFeePercent  Float               @default(3.0)
  updatedAt         DateTime            @updatedAt
}

model Sale {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  total              Float
  discount           Float          @default(0)
  status             SaleStatus     @default(CONCLUIDA)
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  cancelReason       String?
  paymentRef         String?        @unique
  mpOrderId          String?        @unique
  terminalTxId       String?
  paymentSource      PaymentSource?
  paymentConfirmedAt DateTime?
  createdAt          DateTime       @default(now())

  items    SaleItem[]
  payments Payment[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
  /// Custo unitário no momento da venda (null = venda antiga, usa Product.cost)
  unitCost  Float?
  total     Float
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
}

model Payment {
  id     String        @id @default(cuid())
  saleId String
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Float
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
